node_modules/

# Other artifacts — not needed for mobile native build
artifacts/api-server/
artifacts/pitch-deck/
artifacts/pitch-deck-light/
artifacts/mockup-sandbox/

# Docs and agent memory
docs/
.agents/
.local/

# Build outputs
dist/
*.log
*.tsbuildinfo
.expo/
