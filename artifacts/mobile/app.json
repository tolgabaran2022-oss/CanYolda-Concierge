{
  "expo": {
    "name": "CanYoldasi",
    "slug": "canyoldasi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.canyoldasi.app",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF7F0",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/cdc58e55-f517-4818-b4fd-e4f41b42bad7",
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.canyoldasi.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": ["tr", "en"],
        "CFBundleDisplayName": "CanYoldaşı",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.canyoldasi.app",
            "CFBundleURLSchemes": ["com.canyoldasi.app", "mobile"]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "citymapper",
          "uber",
          "lyft",
          "transit",
          "truckmap",
          "waze",
          "yandexnavi",
          "yandextaxi",
          "yandexmaps",
          "kakaomap",
          "tmap",
          "szn-mapy",
          "mapswithme",
          "osmandmaps",
          "gett",
          "nmap"
        ],
        "NSLocationWhenInUseUsageDescription": "CanYoldaşı, sokak hayvanlarının konumunu haritada göstermek ve yakınındaki veterinerleri listelemek için konumunuzu kullanır.",
        "NSPhotoLibraryUsageDescription": "CanYoldaşı, sokak hayvanı fotoğrafları yüklemenizi ve profil fotoğrafınızı ayarlamanızı sağlamak için fotoğraf kitaplığınıza erişir.",
        "NSCameraUsageDescription": "Yakındaki sokak hayvanlarının durumunu fotoğraflayarak bildirebilmeniz için kamera erişimi gereklidir."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "com.canyoldasi.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FAF7F0"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CanYoldaşı, sokak hayvanlarının konumunu belirlemek için konumunuzu kullanır.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CanYoldaşı, hayvan fotoğrafı eklemek için fotoğraf kitaplığınıza erişir.",
          "cameraPermission": "Yakındaki sokak hayvanlarının durumunu fotoğraflayarak bildirebilmeniz için kamera erişimi gereklidir."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF7F0",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7C45D9",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "baran23",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "cdc58e55-f517-4818-b4fd-e4f41b42bad7"
      }
    }
  }
}
